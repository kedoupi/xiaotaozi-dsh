{
  "name": "xiaotaozi-dsh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "new": "node scripts/new-plugin.mjs",
    "build": "pnpm -r --filter \"./plugins/**\" build",
    "typecheck": "pnpm -r --filter \"./plugins/**\" typecheck",
    "test": "pnpm -r --filter \"./plugins/**\" test",
    "check-home": "node scripts/doctor.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "node scripts/check-manifest.mjs && node scripts/check-ui-design.mjs && pnpm typecheck && pnpm test && pnpm test:scripts",
    "check:build": "pnpm build && node scripts/check-manifest.mjs --require-lib",
    "check:path": "node scripts/check-path-install.mjs",
    "check:cli": "cd apps/cli && pnpm check",
    "smoke:sandbox": "node scripts/smoke-sandbox.mjs",
    "dev": "node scripts/sandbox-dev.mjs",
    "dev-link": "node scripts/link-plugin.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.11"
  }
}
