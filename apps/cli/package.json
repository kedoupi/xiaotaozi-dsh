{
  "name": "xiaotaozi-dsh-cli",
  "version": "0.3.0",
  "description": "Xiaotaozi command-line interface for DeepSeek Harness",
  "type": "module",
  "bin": {
    "xtz": "lib/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kedoupi/xiaotaozi-dsh.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm test"
  },
  "keywords": [
    "xiaotaozi",
    "deepseek-harness",
    "dsh",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "pnpm": "11.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  }
}
